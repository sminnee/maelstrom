{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    // The jig plugin's source sits in its own package, beside its own copy of
    // vite. One copy for the whole program, or the two Plugin types clash.
    "paths": { "vite": ["./node_modules/vite"] }
  },
  "include": ["vite.config.ts", "../vite-plugin-mael-jig/src/plugin.ts"]
}
