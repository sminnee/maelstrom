#!/usr/bin/env python3
"""Release maelstrom: bump the version, retitle the changelog, and push a tag.

Usage: bin/publish [--minor|--major] [--dry-run]

Requires a non-empty Unreleased section in CHANGELOG.md.

In order it rebases onto origin/main, runs the gates, writes the new version,
retitles the changelog, commits, tags, and pushes the commit and the tag. The
tag push runs .github/workflows/release.yml, which builds the release bundle
and publishes it as a GitHub Release.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

PYPROJECT = Path("pyproject.toml")
#: Every package's version, as (pyproject, __init__) pairs. The root is first
#: and is the one read; the workspace members move with it in lockstep. The root
#: builds no package, so it has no ``__init__``.
VERSIONED: list[tuple[Path, Path | None]] = [
    (PYPROJECT, None),
    (Path("cli/pyproject.toml"), Path("cli/src/mael_cli/__init__.py")),
    (Path("lib/common/pyproject.toml"), Path("lib/common/src/mael_common/__init__.py")),
    (Path("lib/agent/pyproject.toml"), Path("lib/agent/src/mael_agent/__init__.py")),
    (Path("lib/domain/pyproject.toml"), Path("lib/domain/src/mael_domain/__init__.py")),
    (
        Path("agent-daemon/pyproject.toml"),
        Path("agent-daemon/src/mael_daemon/__init__.py"),
    ),
    (
        Path("orchestrator-api/pyproject.toml"),
        Path("orchestrator-api/src/mael_orchestrator/__init__.py"),
    ),
]
LOCK = Path("uv.lock")
CHANGELOG = Path("CHANGELOG.md")

UNRELEASED_HEADING = "## [Unreleased]"


def current_version() -> str:
    match = re.search(
        r'^version = "(.+?)"', PYPROJECT.read_text(encoding="utf-8"), re.MULTILINE
    )
    if not match:
        sys.exit("Error: could not find version in pyproject.toml")
    return match.group(1)


def bump(version: str, part: str) -> str:
    major, minor, patch = (int(x) for x in version.split("."))
    if part == "major":
        return f"{major + 1}.0.0"
    if part == "minor":
        return f"{major}.{minor + 1}.0"
    return f"{major}.{minor}.{patch + 1}"


def write_version(old: str, new: str) -> None:
    """Write the new version to every file that records it.

    ``uv.lock`` records each package's version alongside its pyproject.toml and
    its ``__init__``, so every one of those files has to move together. They
    are written here rather than at the call sites because every path that
    writes a version -- the bump and the dry-run revert -- has to keep them
    all in step, and a lock that disagrees with the
    package it locks is wrong however it got that way.
    """
    for pyproject, init in VERSIONED:
        pyproject.write_text(
            pyproject.read_text(encoding="utf-8").replace(
                f'version = "{old}"', f'version = "{new}"', 1
            ),
            encoding="utf-8",
        )
        if init is None:
            continue
        init.write_text(
            init.read_text(encoding="utf-8").replace(
                f'__version__ = "{old}"', f'__version__ = "{new}"', 1
            ),
            encoding="utf-8",
        )
    run("uv", "lock")


def unreleased_body() -> str:
    """Return the text under the Unreleased heading, up to the next release.

    A release with nothing written under Unreleased is the failure this
    guards: the tag carries no content of its own, so an empty section is the
    difference between a consumer being able to read what changed and not.
    """
    text = CHANGELOG.read_text(encoding="utf-8")
    if UNRELEASED_HEADING not in text:
        sys.exit(f"Error: {CHANGELOG} has no '{UNRELEASED_HEADING}' heading")
    after = text.split(UNRELEASED_HEADING, 1)[1]
    # The next "## " heading is the previous release; everything before it
    # belongs to Unreleased.
    body = re.split(r"^## ", after, maxsplit=1, flags=re.MULTILINE)[0]
    return body.strip()


def require_release_notes() -> None:
    if not CHANGELOG.exists():
        sys.exit(f"Error: {CHANGELOG} not found")
    if not unreleased_body():
        sys.exit(
            f"Error: the '{UNRELEASED_HEADING}' section of {CHANGELOG} is empty. Write the release notes first."
        )


def retitle_unreleased(new: str, released_on: str) -> None:
    """Rename Unreleased to the version being released, and open a fresh one."""
    text = CHANGELOG.read_text(encoding="utf-8")
    CHANGELOG.write_text(
        text.replace(
            UNRELEASED_HEADING, f"{UNRELEASED_HEADING}\n\n## [{new}] - {released_on}", 1
        ),
        encoding="utf-8",
    )


def run(*command: str) -> None:
    try:
        subprocess.run(command, check=True)
    except FileNotFoundError:
        # A missing tool is a setup problem, and the traceback names it far
        # less clearly than this does.
        sys.exit(f"Error: {command[0]} is not on PATH")


def require_clean_worktree() -> None:
    """Refuse to release from a dirty tree.

    The release commit stages only the version files and the changelog, and
    the tag names the whole tree: anything else in flight would be released
    without being committed.
    """
    result = subprocess.run(
        ("git", "status", "--porcelain"), check=True, capture_output=True, text=True
    )
    if result.stdout.strip():
        sys.exit("Error: working tree is not clean. Commit or stash first.")


def main() -> int:
    parser = argparse.ArgumentParser(description="Release maelstrom")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--minor", action="store_true", help="bump the minor version")
    group.add_argument("--major", action="store_true", help="bump the major version")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="run the gates and build the bundle; do not commit, tag or push",
    )
    args = parser.parse_args()

    if not PYPROJECT.exists():
        sys.exit("Error: run from the repository root")

    require_clean_worktree()

    # Rebase first, so the commit this run tags is already in its final form.
    # A tag written before a rebase ends up on an orphaned commit.
    if not args.dry_run:
        run("mael", "sync", "--abort")

    # Before the gates, because it is the cheapest failure here and the most
    # annoying one to hit after a full gate run.
    require_release_notes()

    old = current_version()
    new = bump(old, "major" if args.major else "minor" if args.minor else "patch")
    print(f"Version {old} -> {new}")

    # Gates must pass before anything is tagged. A release runs all three
    # whatever changed, in the same order .github/workflows/test.yml uses.
    run("uv", "run", "pytest", "-m", "not e2e")
    run("uv", "run", "pytest", "-m", "e2e", "-v")
    run("bin/lint")

    write_version(old, new)

    if args.dry_run:
        # The version files are written, so the tree is dirty on purpose.
        run("bin/build-bundle", "--allow-dirty", "--tag", f"v{new}")
        print("Dry run: built the bundle, did not tag. Reverting the version bump.")
        write_version(new, old)
        return 0

    retitle_unreleased(new, date.today().isoformat())
    versioned = [str(path) for pair in VERSIONED for path in pair if path is not None]
    run("git", "add", *versioned, str(LOCK), str(CHANGELOG))
    run("git", "commit", "-m", f"chore: release v{new}")

    # A push can fail: origin/main moved during the gate run, or auth expired.
    # The commit and the tag are then local, and nothing is released.
    try:
        run("git", "tag", f"v{new}")
        run("git", "push")
        run("git", "push", "origin", f"v{new}")
    except subprocess.CalledProcessError:
        print(
            f"The push failed. The release commit and tag v{new} are local only.\n"
            f"Finish with: git push && git push origin v{new}",
            file=sys.stderr,
        )
        return 1

    print(f"Tagged and pushed v{new}. .github/workflows/release.yml publishes it.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
