#!/bin/sh
# The project's install_cmd: dependencies, then the state database.
# The migration reads its notebook root from this checkout's `.env`, so run
# from the checkout root. It needs only the Python dependencies, so it runs
# before pnpm, whose failure would otherwise skip it.
set -e
cd "$(dirname "$0")/.."
uv sync --extra dev
uv run python -m mael_domain.state_db.migrate
# The app's dev server loads the jig plugin's source, and its dependencies.
# Each runs from its own folder, not with --dir: corepack reads packageManager
# from the cwd, and with none it fetches the latest pnpm.
(cd vite-plugin-mael-jig && pnpm install --frozen-lockfile)
(cd orchestrator-ui && pnpm install --frozen-lockfile)
