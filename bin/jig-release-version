#!/usr/bin/env python3
"""Work out and stamp the jig plugin's release version. The git tags hold it, not the source.

Usage:
  bin/jig-release-version next <patch|minor|major|X.Y.Z>
  bin/jig-release-version stamp <X.Y.Z>

`next` bumps the highest plain `vite-plugin-mael-jig@X.Y.Z` tag, and refuses
when HEAD is already released. It prints `version=X.Y.Z` and `previous=A.B.C`
in the form `$GITHUB_OUTPUT` takes. `stamp` writes the version over the
`0.0.0-dev` placeholder in `vite-plugin-mael-jig/package.json` for the build,
which never commits it.
Both run in the repo root. .github/workflows/release-jig.yml runs them.
"""

import re
import subprocess
import sys
from pathlib import Path

PREFIX = "vite-plugin-mael-jig@"
MANIFEST = Path("vite-plugin-mael-jig/package.json")
PLACEHOLDER = '"version": "0.0.0-dev"'
PLAIN = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")


def parse(version: str) -> tuple[int, int, int] | None:
    """The version as a sort key, or None when it is not plain X.Y.Z."""
    match = PLAIN.match(version)
    if not match:
        return None
    major, minor, patch = (int(part) for part in match.groups())
    return major, minor, patch


def require_plain(version: str) -> tuple[int, int, int]:
    # Plain X.Y.Z only: npm would make a pre-release the `latest` dist-tag.
    key = parse(version)
    if key is None:
        sys.exit(f"error: version must look like 1.2.3, got: {version}")
    return key


def released_versions(*args: str) -> list[str]:
    out = subprocess.run(
        ["git", "tag", "-l", *args, f"{PREFIX}*"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    versions = (tag.removeprefix(PREFIX) for tag in out.split())
    return [version for version in versions if parse(version)]


def next_version(bump: str) -> None:
    released = released_versions("--points-at", "HEAD")
    if released:
        sys.exit(f"error: HEAD is already released as {PREFIX}{released[0]}")
    previous = max(released_versions(), key=require_plain, default="")
    major, minor, patch = require_plain(previous) if previous else (0, 0, 0)
    if bump == "patch":
        version = f"{major}.{minor}.{patch + 1}"
    elif bump == "minor":
        version = f"{major}.{minor + 1}.0"
    elif bump == "major":
        version = f"{major + 1}.0.0"
    elif require_plain(bump) <= (major, minor, patch):
        sys.exit(
            f"error: {bump} is not above the highest release {previous or '0.0.0'}"
        )
    else:
        version = bump
    print(f"version={version}")
    print(f"previous={previous}")


def stamp(version: str) -> None:
    _ = require_plain(version)
    text = MANIFEST.read_text(encoding="utf-8")
    count = text.count(PLACEHOLDER)
    if count != 1:
        sys.exit(f"error: {MANIFEST} names {PLACEHOLDER} {count} times, expected once")
    MANIFEST.write_text(
        text.replace(PLACEHOLDER, f'"version": "{version}"'), encoding="utf-8"
    )


def main(argv: list[str]) -> None:
    if len(argv) != 2 or argv[0] not in ("next", "stamp"):
        sys.exit(__doc__.split("\n\n")[1])
    if argv[0] == "next":
        next_version(argv[1])
    else:
        stamp(argv[1])


if __name__ == "__main__":
    main(sys.argv[1:])
