{
  "name": "vite-plugin-mael-jig",
  "version": "0.0.0",
  "description": "The maelstrom jig: a Vite dev-server overlay that sends CSS and instructions to the agent in the worktree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sminnee/maelstrom.git",
    "directory": "vite-plugin-mael-jig"
  },
  "keywords": [
    "vite-plugin",
    "maelstrom"
  ],
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && knip",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "dependencies": {
    "modern-screenshot": "^4.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "ws": "8.22.0"
  }
}
